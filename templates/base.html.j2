<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Simulation runs{% endblock %}</title>
  <style>
    :root {
      color-scheme: light dark;
      --background: #f4f6f8;
      --surface: #ffffff;
      --text: #17202a;
      --muted: #667085;
      --border: #d8dee6;
      --accent: #2457a7;
      --code: #eef2f6;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --background: #11151a;
        --surface: #191f26;
        --text: #e7edf3;
        --muted: #a5b0bd;
        --border: #35404c;
        --accent: #8bb8ff;
        --code: #10151b;
      }
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
    }
    main { width: min(1040px, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 5rem; }
    a { color: var(--accent); }
    h1 { margin: 0 0 0.35rem; line-height: 1.15; }
    h2 { margin-top: 2.4rem; }
    .lede, .muted { color: var(--muted); }
    .panel {
      margin-top: 1.5rem;
      padding: 1.25rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: var(--surface);
    }
    .metadata {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.8rem;
      margin: 1.5rem 0;
    }
    .metadata div { padding: 0.8rem; border: 1px solid var(--border); border-radius: 0.6rem; background: var(--surface); }
    .metadata dt { color: var(--muted); font-size: 0.82rem; }
    .metadata dd { margin: 0.2rem 0 0; overflow-wrap: anywhere; }
    pre {
      overflow-x: auto;
      margin: 0;
      padding: 1rem;
      border-radius: 0.55rem;
      background: var(--code);
      font: 0.9rem/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      white-space: pre-wrap;
    }
    .run-list { display: grid; gap: 0.8rem; padding: 0; list-style: none; }
    .run-group { margin-top: 2.2rem; }
    .run-group h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.55rem; margin-bottom: 0.8rem; }
    .group-label { color: var(--muted); font-size: 0.82rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.04em; }
    .run-count { color: var(--muted); font-size: 0.85rem; font-weight: 400; }
    .run-list a {
      display: block;
      padding: 1rem 1.1rem;
      border: 1px solid var(--border);
      border-radius: 0.65rem;
      background: var(--surface);
      text-decoration: none;
    }
    .run-list a:hover { border-color: var(--accent); }
    .run-name { display: block; color: var(--text); font-weight: 650; }
    .run-details { display: block; margin-top: 0.25rem; color: var(--muted); font-size: 0.9rem; }
    .figure { margin: 1.5rem 0; }
    .figure img { display: block; max-width: 100%; height: auto; border: 1px solid var(--border); border-radius: 0.6rem; }
    .figure figcaption { margin-top: 0.45rem; color: var(--muted); font-size: 0.9rem; }
    .back-link { display: inline-block; margin-bottom: 1.5rem; }
  </style>
</head>
<body>
  <main>
    {% block content %}{% endblock %}
  </main>
</body>
</html>
